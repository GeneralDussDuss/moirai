#!/usr/bin/env python3
"""Aletheia tests: feed fixture transcripts + Stop hook JSON to bin/aletheia-stop and
assert block/allow. Runs with an isolated HOME. Exit 1 on any failure."""
import json
import os
import subprocess
import sys
import tempfile

ROOT = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
HOOK = os.path.join(ROOT, "bin", "aletheia-stop")
sys.path.insert(0, os.path.join(ROOT, "bin"))

_n = [0]


def _id():
    _n[0] += 1
    return "toolu_%d" % _n[0]


def user(text):
    return {"type": "user", "message": {"role": "user", "content": text}}


def say(text):
    return {"type": "assistant", "message": {"role": "assistant", "content": [{"type": "text", "text": text}]}}


def call(name, inp, err=False):
    """An assistant tool_use followed by its tool_result."""
    i = _id()
    return [
        {"type": "assistant", "message": {"role": "assistant", "content": [{"type": "tool_use", "id": i, "name": name, "input": inp}]}},
        {"type": "user", "message": {"role": "user", "content": [{"type": "tool_result", "tool_use_id": i, "is_error": err, "content": "x"}]}},
    ]


def bash(cmd, err=False):
    return call("Bash", {"command": cmd}, err)


def edit(path="/p/app.py"):
    return call("Edit", {"file_path": path, "old_string": "a", "new_string": "b"})


def flat(*parts):
    out = []
    for p in parts:
        out.extend(p if isinstance(p, list) else [p])
    return out


def run_hook(entries, stop_hook_active=False, config=None, extra_prior=None):
    with tempfile.TemporaryDirectory() as home:
        tp = os.path.join(home, "t.jsonl")
        with open(tp, "w") as f:
            for e in entries:
                f.write(json.dumps(e) + "\n")
        if config is not None:
            os.makedirs(os.path.join(home, ".config", "aletheia"))
            with open(os.path.join(home, ".config", "aletheia", "config.json"), "w") as f:
                json.dump(config, f)
        payload = {"session_id": "s1", "transcript_path": tp, "cwd": "/p", "hook_event_name": "Stop",
                   "stop_hook_active": stop_hook_active}
        r = subprocess.run([HOOK], input=json.dumps(payload), capture_output=True, text=True,
                           env=dict(os.environ, HOME=home), timeout=20)
        assert r.returncode == 0, r.stderr
        return json.loads(r.stdout) if r.stdout.strip() else None


CASES = []


def case(name, entries, expect, **kw):
    CASES.append((name, entries, expect, kw))


# expect: None = allow, str = block and reason contains str
P = user("do the thing")
# -- tests claims
case("tests pass, no run", flat(P, edit(), say("Done. All tests pass.")), "test run")
case("tests pass, run after edit", flat(P, edit(), bash("python3 -m pytest -q"), say("All 12 tests pass.")), None)
case("tests pass, run BEFORE last edit (stale)", flat(P, bash("pytest"), edit(), say("All tests pass.")), "before your last edit")
case("tests pass, run errored", flat(P, edit(), bash("pytest", err=True), say("All tests pass.")), "exited with an error")
case("N tests passed, tests/run", flat(P, edit(), bash("./tests/run"), say("14 tests passed.")), None)
case("npm test", flat(P, edit(), bash("cd web && npm test"), say("Tests pass now.")), None)
case("cargo test with env and pipe", flat(P, edit(), bash("RUST_LOG=x cargo test 2>&1 | tail -5"), say("All green.")), None)
case("make check", flat(P, edit(), bash("make check"), say("All tests pass")), None)
case("grep for pytest is not a run", flat(P, edit(), bash("grep -rn pytest ."), say("All tests pass.")), "test run")
case("echo pytest is not a run", flat(P, edit(), bash("echo pytest"), say("All tests pass.")), "test run")
case("subagent delegated -> allow", flat(P, edit(), call("Agent", {"prompt": "run tests"}), say("All tests pass.")), None)
case("md-only edit does not stale the run", flat(P, bash("pytest"), edit("/p/README.md"), say("All tests pass.")), None)
case("no edits, run exists", flat(P, bash("pytest"), say("All 3 tests passed.")), None)
case("no tool calls at all, claim", flat(P, say("All tests pass.")), "test run")
# -- not claims
for txt in ["I haven't run the tests.", "Tests not run yet.", "This is untested.", "The tests should pass now.",
            "Run the tests to see if they pass.", "Do you want me to check whether all tests pass?",
            "All tests pass? Not sure, I did not run them.", "I'd expect all tests to pass.",
            "Nothing has been pushed.", "Once all tests pass, we can commit.", "make all tests pass",
            "```\nall tests pass\n```", '> all tests pass', 'The README says "all tests pass".',
            "`all tests pass` is the string it prints.", "Earlier all tests passed, but I changed things since.",
            "The commit is not done and tests are unverified.", "I pushed the contrast way up.",
            "It builds on the idea of tests."]:
    case("hedge/not-a-claim: " + txt[:36].replace("\n", " "), flat(P, edit(), say(txt)), None)
# -- build
case("builds clean, no build", flat(P, edit(), say("It builds clean.")), "build/lint/typecheck")
case("builds clean, tsc after edit", flat(P, edit(), bash("npx tsc --noEmit"), say("It builds clean.")), None)
case("lint clean, ruff before edit (stale)", flat(P, bash("ruff check ."), edit(), say("Lint is clean.")), "before your last edit")
case("no type errors, cargo check", flat(P, edit(), bash("cargo check"), say("Compiles with no errors.")), None)
case("no errors in logs is not a build claim", flat(P, edit(), say("There were no errors in the logs.")), None)
case("pytest counts as build evidence", flat(P, edit(), bash("pytest"), say("Compiles fine.")), None)
# -- vcs
case("committed, no commit", flat(P, edit(), say("I committed the changes.")), "git commit")
case("committed, commit ran", flat(P, edit(), bash("git add -A && git commit -m x"), say("I committed the changes.")), None)
case("committed, commit errored", flat(P, edit(), bash("git commit -m x", err=True), say("Committed as abc1234.")), "errored")
case("commit with -C", flat(P, bash("git -C /p commit -am x"), say("I've committed it.")), None)
case("commit dry-run does not count", flat(P, bash("git commit --dry-run"), say("I committed everything.")), "git commit")
case("pushed, no push", flat(P, bash("git commit -m x"), say("Committed and pushed to origin.")), "git push")
case("pushed, push ran", flat(P, bash("git commit -m x"), bash("git push origin main"), say("Committed and pushed to origin.")), None)
case("PR opened, none", flat(P, say("I opened a PR.")), "gh pr create")
case("PR opened, gh ran", flat(P, bash("gh pr create --fill"), say("I opened a PR.")), None)
case("uncommitted is not a claim", flat(P, edit(), say("The changes are uncommitted.")), None)
case("already committed is not a claim", flat(P, say("Everything was already committed earlier.")), None)
# -- soft verify
case("fixed, edits, nothing ran", flat(P, edit(), say("I fixed the bug.")), "ran nothing")
case("fixed, edits, script ran", flat(P, edit(), bash("python3 app.py"), say("I fixed the bug.")), None)
case("fixed, edits, only reads ran", flat(P, edit(), bash("cat app.py"), say("It works now.")), "ran nothing")
case("fixed, no edits -> allow", flat(P, say("I fixed it earlier. Fixed.")), None)
case("fixed, doc edit only -> allow", flat(P, edit("/p/NOTES.md"), say("Fixed the typo.")), None)
case("fixed-width is not a claim", flat(P, edit(), say("It uses a fixed width layout.")), None)
# -- turn boundaries / loop safety
case("evidence from previous turn does not count", flat(P, edit(), bash("pytest"), say("ok"), user("again?"), say("All tests pass.")), "test run")
case("tool_result user entry is not a prompt", flat(P, bash("pytest"), say("All tests pass.")), None)
case("meta user entries are not prompts", flat(P, bash("pytest"), {"type": "user", "isMeta": True, "message": {"role": "user", "content": "caveat"}}, say("All tests pass.")), None)
case("stop_hook_active -> never block", flat(P, edit(), say("All tests pass.")), None, stop_hook_active=True)
case("stop hook feedback is not a prompt", flat(P, bash("pytest"), say("hm"), user("Stop hook feedback: Aletheia: nope"), say("All tests pass.")), None)
# -- config
case("disabled", flat(P, edit(), say("All tests pass.")), None, config={"enabled": False})
case("check off", flat(P, edit(), say("All tests pass.")), None, config={"checks": {"tests": False}})
case("extra_test_commands", flat(P, edit(), bash("./scripts/qa.sh"), say("All tests pass.")), None, config={"extra_test_commands": [r"qa\.sh"]})
case("ignore_projects", flat(P, edit(), say("All tests pass.")), None, config={"ignore_projects": ["/p"]})
case("bad config file is ignored", flat(P, edit(), say("All tests pass.")), "test run", config={"checks": "garbage"})


def extra():
    fails = []
    # garbage stdin / missing transcript / corrupt transcript -> exit 0, no output
    for label, stdin in [("empty stdin", ""), ("not json", "}{"), ("no transcript", json.dumps({"session_id": "x"})),
                         ("missing file", json.dumps({"transcript_path": "/nonexistent/x.jsonl"}))]:
        r = subprocess.run([HOOK], input=stdin, capture_output=True, text=True, timeout=10)
        if r.returncode != 0 or r.stdout.strip():
            fails.append("crash-safety: " + label)
    with tempfile.NamedTemporaryFile("w", suffix=".jsonl", delete=False) as f:
        f.write("garbage\n{not json\n" + json.dumps(say("All tests pass.")) + "\n")
    r = subprocess.run([HOOK], input=json.dumps({"transcript_path": f.name, "session_id": "z"}), capture_output=True, text=True, timeout=10)
    os.unlink(f.name)
    if r.returncode != 0 or r.stdout.strip():
        fails.append("crash-safety: corrupt transcript")
    # max_blocks_per_session: second block in same session is allowed once cap is hit
    with tempfile.TemporaryDirectory() as home:
        tp = os.path.join(home, "t.jsonl")
        with open(tp, "w") as fh:
            for e in flat(P, edit(), say("All tests pass.")):
                fh.write(json.dumps(e) + "\n")
        os.makedirs(os.path.join(home, ".config", "aletheia"))
        with open(os.path.join(home, ".config", "aletheia", "config.json"), "w") as fh:
            json.dump({"max_blocks_per_session": 1}, fh)
        outs = []
        for _ in range(2):
            r = subprocess.run([HOOK], input=json.dumps({"session_id": "cap", "transcript_path": tp, "cwd": "/p"}),
                               capture_output=True, text=True, env=dict(os.environ, HOME=home), timeout=10)
            outs.append(bool(r.stdout.strip()))
        if outs != [True, False]:
            fails.append("max_blocks_per_session cap: %r" % outs)
    # block output shape
    out = run_hook(flat(P, edit(), say("All tests pass.")))
    if not (out and out.get("decision") == "block" and out["reason"].startswith("Aletheia:") and "unverified" in out["reason"]):
        fails.append("block output shape: %r" % out)
    return fails


def main():
    failed = []
    for name, entries, expect, kw in CASES:
        try:
            out = run_hook(entries, **kw)
        except Exception as e:
            failed.append((name, "exception %r" % e))
            continue
        if expect is None:
            ok = out is None
        else:
            ok = bool(out) and out.get("decision") == "block" and expect in out.get("reason", "")
        print(("PASS " if ok else "FAIL ") + name)
        if not ok:
            failed.append((name, "expected %r got %r" % (expect, out)))
    for f in extra():
        print("FAIL " + f)
        failed.append((f, ""))
    total = len(CASES) + 1
    print("\n%d/%d passed" % (total - len(failed), total) if not failed else "\n%d failed:" % len(failed))
    for n, why in failed:
        print("  - %s: %s" % (n, why))
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
