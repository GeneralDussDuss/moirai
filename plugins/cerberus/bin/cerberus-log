#!/usr/bin/env python3
"""Show recent Cerberus catches. Usage: cerberus-log [-n N] [--errors]"""
import os, sys, json, time
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import cerberus_core as c

n, errors = 20, False
a = sys.argv[1:]
while a:
    x = a.pop(0)
    if x == "-n" and a: n = int(a.pop(0))
    elif x == "--errors": errors = True
d = c.state_dir()
if errors:
    p = os.path.join(d, "errors.log")
    print(open(p).read()[-4000:] if os.path.exists(p) else "no errors logged")
    sys.exit(0)
p = os.path.join(d, "catches.jsonl")
if not os.path.exists(p):
    print("no catches logged yet (%s)" % p); sys.exit(0)
rows = []
for line in open(p, errors="replace"):
    try: rows.append(json.loads(line))
    except Exception: pass
rows = rows[-n:]
for r in rows:
    t = time.strftime("%m-%d %H:%M", time.localtime(r.get("ts", 0)))
    print("%s  %-6s %-5s %-18s %s" % (t, r.get("head"), r.get("action"), r.get("rule"), r.get("tool")))
    print("    %s" % r.get("reason", ""))
    if r.get("input"): print("    > %s" % r["input"])
print("(%d shown, log: %s)" % (len(rows), p))
