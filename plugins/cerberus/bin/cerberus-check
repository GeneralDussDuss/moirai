#!/usr/bin/env python3
"""Dry-run the heads on a command (argv or stdin). Usage:
  cerberus-check [--tool NAME] [--cwd DIR] [--siren] [--source LABEL] [TEXT...]
With --siren the text is treated as fetched content and scanned for injection."""
import os, sys, json
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
import cerberus_core as c

def main():
    a = sys.argv[1:]
    tool, cwd, siren, source = "Bash", os.getcwd(), False, "pasted text"
    rest = []
    while a:
        x = a.pop(0)
        if x == "--tool" and a: tool = a.pop(0)
        elif x == "--cwd" and a: cwd = a.pop(0)
        elif x == "--source" and a: source = a.pop(0)
        elif x == "--siren": siren = True
        else: rest.append(x)
    text = " ".join(rest) if rest else sys.stdin.read()
    text = text.strip("\n")
    cfg = c.load_config()
    if siren:
        r = c.siren_scan(text, source, cfg)
        print("siren: score %d (threshold %d)" % (r["score"], cfg["siren"]["min_score"]))
        for m in r["markers"]: print("  marker: %s (+%d)" % (m[0], m[1]))
        if r["context"]: print("  discussion context detected: score discounted")
        print("verdict: " + (r["message"] or "quiet, nothing injected into context"))
        return
    if tool == "Bash": ti = {"command": text}
    elif tool == "WebFetch": ti = {"url": text, "prompt": ""}
    elif tool == "WebSearch": ti = {"query": text}
    else: ti = {"input": text}
    findings = c.pre_findings({"tool_name": tool, "tool_input": ti, "cwd": cwd}, cfg)
    if not findings:
        print("verdict: ALLOW (no head objects)")
        return
    for f in findings:
        print("%-6s %-5s %-18s %s" % (f["head"], f["action"].upper(), f["rule"], f["reason"]))
    worst = "DENY" if any(f["action"] == "deny" for f in findings) else "ASK"
    print("verdict: %s" % worst)

main()
