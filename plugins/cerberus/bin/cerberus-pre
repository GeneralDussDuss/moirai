#!/usr/bin/env python3
"""PreToolUse hook: egress + ruin. Never fails the session."""
import os, sys, json
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
try:
    import cerberus_core as c
    data = json.load(sys.stdin)
    cfg = c.load_config()
    out = c.pre_decision(data, cfg)
    if out:
        sys.stdout.write(json.dumps(out))
except BaseException as e:  # noqa
    try:
        import cerberus_core as c
        c.log_error("pre", e)
    except BaseException:
        pass
sys.exit(0)
